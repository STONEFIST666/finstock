<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FinStock — Real-time Stock Tracker</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

  <a class="skip-link" href="#main-content">Skip to main content</a>

  <%
    // ---------- Presentation-only formatting helpers (no business logic) ----------
    const hasValue = (v) => v !== null && v !== undefined && String(v).trim() !== "" && !isNaN(parseFloat(v));
    const orNa = (v) => (v === null || v === undefined || String(v).trim() === "") ? "N/A" : v;

    // Market cap: 1.25T / 850.12B / 450M instead of long numbers
    const formatMarketCap = (v) => {
      if (!hasValue(v)) return "N/A";
      const n = parseFloat(v);
      if (n >= 1e12) return "$" + (n / 1e12).toFixed(2) + "T";
      if (n >= 1e9) return "$" + (n / 1e9).toFixed(2) + "B";
      if (n >= 1e6) return "$" + (n / 1e6).toFixed(2) + "M";
      return "$" + n.toLocaleString("en-US");
    };

    const formatCurrency = (v) => hasValue(v) ? "$" + parseFloat(v).toFixed(2) : "N/A";
    const formatRatio = (v) => hasValue(v) ? parseFloat(v).toFixed(2) : "N/A";
    // Alpha Vantage returns ROE / profit margin / dividend yield as decimal fractions (e.g. 0.1452)
    const formatPercent = (v) => hasValue(v) ? (parseFloat(v) * 100).toFixed(2) + "%" : "N/A";

    // Serialize historicalData for the browser chart. This raw JSON is injected
    // via an unescaped EJS output tag inside a script tag, so "<" is escaped as
    // \u003c to prevent a closing-script-tag breakout (defense-in-depth — the
    // API dates are safe anyway).
    const historicalDataJson = JSON.stringify(historicalData || []).replace(/</g, "\\u003c");
  %>

  <!-- ====== Hero ====== -->
  <header class="hero">
    <div class="hero__bg"></div>
    <div class="container">
      <nav class="nav">
        <div class="nav__brand">
          <span class="nav__logo">Fin</span><span class="nav__logo nav__logo--accent">Stock</span>
        </div>
        <div class="nav__tagline">Real-time Market Data</div>
      </nav>
      <div class="hero__content">
        <h1 class="hero__title">
          Track the stocks<br />
          <span class="hero__title--gradient">that matter most</span>
        </h1>
        <p class="hero__subtitle">Get instant access to real-time stock prices, opening values, daily highs and lows — all in one place.</p>
      </div>

      <!-- ====== Search ====== -->
      <form id="search-form" class="search" action="/search" method="POST">
        <label for="stock-symbol" class="visually-hidden">Stock symbol</label>
        <div class="search__wrapper">
          <span class="search__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </span>
          <input
            type="text"
            id="stock-symbol"
            name="stock-symbol"
            class="search__input"
            placeholder="Search symbol… e.g. AAPL, TSLA, GOOGL"
            required
            autocomplete="off"
            spellcheck="false"
            maxlength="10"
            autocapitalize="characters"
          />
          <button type="submit" class="search__button">
            <span class="search__button-text">Search</span>
            <svg class="search__button-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
            <span class="search__spinner" aria-hidden="true"></span>
          </button>
        </div>

        <p class="search__feedback" id="search-feedback" role="alert" hidden></p>
      </form>

      <div class="hero__hints" role="group" aria-label="Popular stock symbols">
        <span class="hero__hints-label">Popular:</span>
        <button type="button" class="hero__hint" data-symbol="AAPL">AAPL</button>
        <button type="button" class="hero__hint" data-symbol="TSLA">TSLA</button>
        <button type="button" class="hero__hint" data-symbol="GOOGL">GOOGL</button>
        <button type="button" class="hero__hint" data-symbol="MSFT">MSFT</button>
        <button type="button" class="hero__hint" data-symbol="AMZN">AMZN</button>
      </div>
    </div>
  </header>

  <!-- ====== Main ====== -->
  <main class="main" id="main-content" tabindex="-1">
    <div class="container">

      <!-- ====== Watchlist (localStorage, no account required) ====== -->
      <section class="watchlist" id="watchlist" aria-labelledby="watchlist-title" hidden>
        <div class="watchlist__header">
          <div class="watchlist__heading">
            <h2 class="watchlist__title" id="watchlist-title">Watchlist</h2>
            <span class="watchlist__count" id="watchlist-count" aria-hidden="true">0</span>
          </div>
          <p class="watchlist__hint">Saved in this browser</p>
        </div>
        <ul class="watchlist__list" id="watchlist-list" aria-label="Saved symbols" hidden></ul>
        <p class="watchlist__empty" id="watchlist-empty">
          No saved symbols yet. Search for a stock, then select <strong>Watch</strong> to save it here.
        </p>
        <p class="watchlist__status" id="watchlist-status" role="status" aria-live="polite"></p>
      </section>

      <!-- ====== Portfolio (localStorage, prices on demand) ====== -->
      <section class="portfolio" id="portfolio" aria-labelledby="portfolio-title" hidden>
        <header class="portfolio__header">
          <div class="portfolio__title-wrapper">
            <h2 class="portfolio__title" id="portfolio-title">Portfolio</h2>
            <p class="portfolio__subtitle" id="portfolio-updated-at">Track cost basis and unrealized P&amp;L</p>
          </div>
          <button type="button" class="portfolio__refresh" id="portfolio-refresh">
            <span class="portfolio__refresh-label">Refresh prices</span>
            <span class="portfolio__spinner" aria-hidden="true"></span>
          </button>
        </header>

        <div class="portfolio__summary" id="portfolio-summary" hidden>
          <div class="portfolio-stat">
            <span class="portfolio-stat__label">Market value</span>
            <span class="portfolio-stat__value" id="portfolio-value">&mdash;</span>
          </div>
          <div class="portfolio-stat">
            <span class="portfolio-stat__label">Cost basis</span>
            <span class="portfolio-stat__value" id="portfolio-cost-total">&mdash;</span>
          </div>
          <div class="portfolio-stat">
            <span class="portfolio-stat__label">Unrealized P&amp;L</span>
            <span class="portfolio-stat__value" id="portfolio-pnl">&mdash;</span>
          </div>
          <div class="portfolio-stat">
            <span class="portfolio-stat__label">Return</span>
            <span class="portfolio-stat__value" id="portfolio-return">&mdash;</span>
          </div>
        </div>

        <form class="portfolio-form" id="portfolio-form">
          <div class="portfolio-form__fields">
            <label class="portfolio-form__field">
              <span>Symbol</span>
              <input type="text" id="portfolio-symbol" name="symbol" placeholder="AAPL" required autocomplete="off" spellcheck="false" maxlength="10" autocapitalize="characters" />
            </label>
            <label class="portfolio-form__field">
              <span>Shares</span>
              <input type="number" id="portfolio-shares" name="shares" placeholder="10" required min="0.000001" step="any" inputmode="decimal" />
            </label>
            <label class="portfolio-form__field">
              <span>Avg cost (USD)</span>
              <input type="number" id="portfolio-cost" name="avgCost" placeholder="150.00" required min="0" step="any" inputmode="decimal" />
            </label>
          </div>
          <div class="portfolio-form__actions">
            <button type="submit" class="portfolio-form__submit">
              <span id="portfolio-submit-label">Add position</span>
            </button>
            <button type="button" class="portfolio-form__cancel" id="portfolio-cancel" hidden>Cancel</button>
          </div>
          <p class="portfolio-form__feedback" id="portfolio-feedback" role="alert" hidden></p>
        </form>

        <div class="portfolio-table-wrap" id="portfolio-table-wrap" hidden>
          <table class="portfolio-table" aria-label="Portfolio positions">
            <thead>
              <tr>
                <th scope="col">Symbol</th>
                <th scope="col">Shares</th>
                <th scope="col">Avg cost</th>
                <th scope="col">Price</th>
                <th scope="col">Value</th>
                <th scope="col">P&amp;L</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody id="portfolio-body"></tbody>
          </table>
        </div>

        <p class="portfolio__empty" id="portfolio-empty">
          No positions yet. Add a symbol, share count, and average cost to start tracking unrealized P&amp;L.
        </p>
        <p class="portfolio__status" id="portfolio-status" role="status" aria-live="polite"></p>
      </section>

      <!-- ====== Search loading skeleton (shown while the POST is in flight) ====== -->
      <div class="search-loading" id="search-loading" hidden>
        <p class="search-loading__status" id="search-loading-status" role="status" aria-live="polite">Fetching market data&hellip;</p>
        <div class="search-loading__card" aria-hidden="true">
          <div class="search-loading__header">
            <span class="skeleton skeleton--avatar"></span>
            <span class="skeleton skeleton--title"></span>
            <span class="skeleton skeleton--price"></span>
          </div>
          <div class="search-loading__metrics">
            <span class="skeleton skeleton--metric"></span>
            <span class="skeleton skeleton--metric"></span>
            <span class="skeleton skeleton--metric"></span>
            <span class="skeleton skeleton--metric"></span>
            <span class="skeleton skeleton--metric"></span>
          </div>
        </div>
        <div class="search-loading__card" aria-hidden="true">
          <span class="skeleton skeleton--chart-heading"></span>
          <span class="skeleton skeleton--chart"></span>
        </div>
      </div>

      <div id="search-results">
      <!-- ====== Error ====== -->
      <% if (error) { %>
        <div class="error-card" role="alert">
          <span class="error-card__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <div class="error-card__content">
            <p class="error-card__title"><%= typeof errorTitle !== "undefined" && errorTitle ? errorTitle : (stock ? "Some data unavailable" : "Unable to fetch stock data") %></p>
            <p class="error-card__message"><%= error %></p>
          </div>
        </div>
      <% } %>

      <!-- ====== Stock Card ====== -->
      <% if (stock) { %>
        <section class="stock-card" aria-label="Stock information for <%= stock.symbol %>">
          <header class="stock-card__header">
            <div class="stock-card__symbol-wrapper">
              <span class="stock-card__symbol-icon"><%= stock.symbol.charAt(0) %></span>
              <div>
                <h2 class="stock-card__symbol"><%= stock.symbol %></h2>
                <p class="stock-card__exchange">NASDAQ</p>
              </div>
              <button
                type="button"
                class="watchlist-toggle"
                data-symbol="<%= stock.symbol %>"
                aria-pressed="false"
                aria-label="Add <%= stock.symbol %> to watchlist"
              >
                <svg class="watchlist-toggle__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                <span class="watchlist-toggle__label">Watch</span>
              </button>
            </div>
            <div class="stock-card__price-block">
              <p class="stock-card__price" id="quote-price" aria-label="Current price: <%= stock.price %>">$<%= stock.price %></p>
              <% if (stock.change && stock.changePercent) { %>
                <p class="stock-card__change <%= parseFloat(stock.change) >= 0 ? 'stock-card__change--up' : 'stock-card__change--down' %>" id="quote-change">
                  <span class="stock-card__change-arrow" id="quote-change-arrow"><%= parseFloat(stock.change) >= 0 ? '▲' : '▼' %></span>
                  <span id="quote-change-text"><%= stock.change %> (<%= stock.changePercent %>)</span>
                </p>
              <% } %>
            </div>
          </header>
          <div class="stock-card__body">
            <dl class="stock-metrics">
              <div class="stock-metrics__item">
                <dt class="stock-metrics__label">Open</dt>
                <dd class="stock-metrics__value" id="quote-open">$<%= stock.open %></dd>
              </div>
              <div class="stock-metrics__item">
                <dt class="stock-metrics__label">High</dt>
                <dd class="stock-metrics__value stock-metrics__value--up" id="quote-high">$<%= stock.high %></dd>
              </div>
              <div class="stock-metrics__item">
                <dt class="stock-metrics__label">Low</dt>
                <dd class="stock-metrics__value stock-metrics__value--down" id="quote-low">$<%= stock.low %></dd>
              </div>
              <div class="stock-metrics__item">
                <dt class="stock-metrics__label">Previous Close</dt>
                <dd class="stock-metrics__value" id="quote-previous-close">$<%= stock.previousClose %></dd>
              </div>
              <div class="stock-metrics__item stock-metrics__item--full">
                <dt class="stock-metrics__label">Volume</dt>
                <dd class="stock-metrics__value stock-metrics__value--mono" id="quote-volume"><%= new Intl.NumberFormat('en-US').format(stock.volume) %></dd>
              </div>
            </dl>
          </div>
          <footer class="stock-card__footer">
            <div class="stock-card__footer-main">
              <p class="stock-card__timestamp" id="quote-updated-at">Data as of the latest trading session</p>
              <button
                type="button"
                class="quote-refresh"
                id="quote-refresh"
                data-symbol="<%= stock.symbol %>"
                data-updated-at="<%= typeof quoteUpdatedAt !== 'undefined' ? quoteUpdatedAt : '' %>"
                data-cached="<%= typeof quoteCached !== 'undefined' && quoteCached ? 'true' : 'false' %>"
              >
                <span class="quote-refresh__label">Refresh</span>
                <span class="quote-refresh__spinner" aria-hidden="true"></span>
              </button>
            </div>
            <p class="quote-refresh__status" id="quote-refresh-status" role="status" aria-live="polite"></p>
          </footer>
        </section>

        <!-- ====== Historical Price Chart (closing price, oldest → newest) ====== -->
        <% if (historicalData && historicalData.length > 0) {
            const latest = historicalData[0];             // API returns newest first
            const oldest = historicalData[historicalData.length - 1];
        %>
          <section class="chart-card" aria-label="Closing price history for <%= stock.symbol %>">
            <header class="chart-card__header">
              <div class="chart-card__title-wrapper">
                <h2 class="chart-card__title">Price History</h2>
                <p class="chart-card__subtitle" id="chart-range-subtitle"><%= oldest.date %> → <%= latest.date %> · <%= historicalData.length %> trading days</p>
              </div>
              <span class="chart-card__badge"><%= stock.symbol %></span>
            </header>

            <!-- Time-range controls: filter the already-loaded data entirely on the client -->
            <div class="chart-card__toolbar" role="group" aria-label="Chart time range">
              <button type="button" class="chart-range" data-range="1M" aria-pressed="false">1M</button>
              <button type="button" class="chart-range" data-range="3M" aria-pressed="false">3M</button>
              <button type="button" class="chart-range" data-range="6M" aria-pressed="false">6M</button>
              <button type="button" class="chart-range is-active" data-range="ALL" aria-pressed="true">ALL</button>
            </div>

            <!-- Technical indicators: computed client-side from the same history -->
            <div class="chart-card__indicators" role="group" aria-label="Technical indicators">
              <span class="chart-card__indicators-label">Indicators</span>
              <button type="button" class="indicator-toggle" data-indicator="sma20" aria-pressed="false">SMA 20</button>
              <button type="button" class="indicator-toggle" data-indicator="sma50" aria-pressed="false">SMA 50</button>
              <button type="button" class="indicator-toggle" data-indicator="sma200" aria-pressed="false">SMA 200</button>
              <button type="button" class="indicator-toggle" data-indicator="rsi" aria-pressed="false" aria-controls="rsi-container">RSI 14</button>
            </div>

            <div class="chart-card__body">
              <div class="chart-card__canvas-wrap">
                <canvas
                  id="price-chart"
                  role="img"
                  aria-label="Line chart of daily closing prices for <%= stock.symbol %>"
                ></canvas>
              </div>
              <p class="chart-card__caption">Daily closing price (USD)</p>

              <!-- RSI lives on its own 0-100 scale, so it gets its own canvas -->
              <div class="chart-card__rsi" id="rsi-container" hidden>
                <div class="chart-card__rsi-wrap">
                  <canvas
                    id="rsi-chart"
                    role="img"
                    aria-label="Relative Strength Index, 14 periods, for <%= stock.symbol %>"
                  ></canvas>
                </div>
                <p class="chart-card__caption">RSI (14) &middot; above 70 overbought &middot; below 30 oversold</p>
              </div>
            </div>
          </section>
        <% } else if (stock) { %>
          <!-- No historical data (e.g. rate-limited): never crash, just say so -->
          <section class="chart-card chart-card--empty" aria-label="Historical price data unavailable">
            <span class="chart-card__empty-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 17 9 11 13 15 21 7"/>
                <polyline points="15 7 21 7 21 13"/>
              </svg>
            </span>
            <p class="chart-card__empty-text">Historical price data unavailable.</p>
          </section>
        <% } %>

        <!-- ====== Market News (loaded on demand to protect API quota) ====== -->
        <section class="news-card" id="news-card" data-symbol="<%= stock.symbol %>" aria-label="Market news for <%= stock.symbol %>">
          <header class="news-card__header">
            <div class="news-card__title-wrapper">
              <h2 class="news-card__title">Market News</h2>
              <p class="news-card__subtitle" id="news-updated-at">Headlines and sentiment for <%= stock.symbol %></p>
            </div>
            <button type="button" class="news-card__load" id="news-load">
              <span class="news-card__load-label">Load news</span>
              <span class="news-card__spinner" aria-hidden="true"></span>
            </button>
          </header>
          <p class="news-card__status" id="news-status" role="status" aria-live="polite"></p>
          <ul class="news-list" id="news-list" aria-label="Recent market news" hidden></ul>
          <p class="news-card__empty" id="news-empty" hidden>No recent news found for this symbol.</p>
        </section>

        <!-- ====== Company Overview Card ====== -->
        <% if (company) {
          const metaParts = [orNa(company.sector), orNa(company.industry)].filter(s => s !== "N/A");
        %>
          <section class="company-card" aria-label="Company overview for <%= orNa(company.name) %>">
            <header class="company-card__header">
              <div class="company-card__title-wrapper">
                <h2 class="company-card__name"><%= orNa(company.name) %></h2>
                <p class="company-card__subtitle"><%= metaParts.length ? metaParts.join(" • ") : "N/A" %></p>
              </div>
              <span class="company-card__badge">Company Overview</span>
            </header>

            <div class="company-card__body">
              <div class="company-description" id="company-description-<%= stock.symbol %>">
                <h3 class="company-description__heading">About Company</h3>
                <% if (company.description && company.description.length > 180) { %>
                  <p class="company-description__text" id="company-description-text-collapsed"><%= company.description.slice(0, 180).trimEnd() %>…</p>
                  <p class="company-description__text company-description__text--expanded" id="company-description-text-full"><%= company.description %></p>
                  <button
                    type="button"
                    class="company-description__toggle"
                    id="company-description-toggle"
                    aria-expanded="false"
                    aria-controls="company-description-text-full"
                  >
                    <span class="company-description__toggle-more">Read More</span>
                    <span class="company-description__toggle-less">Read Less</span>
                    <svg class="company-description__toggle-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </button>
                <% } else { %>
                  <p class="company-description__text company-description__text--full"><%= orNa(company.description) %></p>
                <% } %>
              </div>

              <dl class="company-metrics">
                <div class="company-metrics__item">
                  <dt class="company-metrics__label">Market Cap</dt>
                  <dd class="company-metrics__value"><%= formatMarketCap(company.marketCap) %></dd>
                </div>
                <div class="company-metrics__item">
                  <dt class="company-metrics__label">P/E Ratio</dt>
                  <dd class="company-metrics__value"><%= formatRatio(company.peRatio) %></dd>
                </div>
                <div class="company-metrics__item">
                  <dt class="company-metrics__label">EPS</dt>
                  <dd class="company-metrics__value"><%= formatCurrency(company.eps) %></dd>
                </div>
                <div class="company-metrics__item">
                  <dt class="company-metrics__label">ROE</dt>
                  <dd class="company-metrics__value"><%= formatPercent(company.returnOnEquity) %></dd>
                </div>
                <div class="company-metrics__item">
                  <dt class="company-metrics__label">Profit Margin</dt>
                  <dd class="company-metrics__value"><%= formatPercent(company.profitMargin) %></dd>
                </div>
                <div class="company-metrics__item">
                  <dt class="company-metrics__label">Dividend Yield</dt>
                  <dd class="company-metrics__value"><%= formatPercent(company.dividendYield) %></dd>
                </div>
              </dl>
            </div>
          </section>
        <% } %>

      <% } else { %>
        <div class="empty-state">
          <span class="empty-state__graphic" aria-hidden="true">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </span>
          <h3 class="empty-state__title">No data yet</h3>
          <p class="empty-state__text">Enter a stock symbol above to view real-time market data.</p>
        </div>
      <% } %>
      </div><!-- /#search-results -->

    </div>
  </main>

  <!-- ====== Footer ====== -->
  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <span class="footer__logo">FinStock</span>
          <p class="footer__description">Real-time stock market data at your fingertips.</p>
        </div>
        <div class="footer__links">
          <div class="footer__col">
            <h4 class="footer__heading">Data</h4>
            <ul class="footer__list">
              <li><a href="#" class="footer__link">API</a></li>
              <li><a href="#" class="footer__link">Documentation</a></li>
              <li><a href="#" class="footer__link">Pricing</a></li>
            </ul>
          </div>
          <div class="footer__col">
            <h4 class="footer__heading">Company</h4>
            <ul class="footer__list">
              <li><a href="#" class="footer__link">About</a></li>
              <li><a href="#" class="footer__link">Privacy</a></li>
              <li><a href="#" class="footer__link">Terms</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="footer__bottom">
        <p class="footer__copyright">&copy; 2026 FinStock. Data delayed by at least 15 minutes.</p>
      </div>
    </div>
  </footer>

  <!-- Read More / Read Less toggle (presentation only) -->
  <script>
    (function () {
      var toggles = document.querySelectorAll(".company-description__toggle");
      toggles.forEach(function (button) {
        button.addEventListener("click", function () {
          var expanded = button.getAttribute("aria-expanded") === "true";
          button.setAttribute("aria-expanded", String(!expanded));
          button.parentElement.classList.toggle("company-description--expanded", !expanded);
        });
      });
    })();
  </script>

  <!-- Search: normalize input, validate, lock the form while the request runs -->
  <script>
    (function () {
      var form = document.getElementById("search-form");
      if (!form) return;

      var input = document.getElementById("stock-symbol");
      var button = document.querySelector(".search__button");
      var feedback = document.getElementById("search-feedback");
      var resultsEl = document.getElementById("search-results");
      var loadingEl = document.getElementById("search-loading");
      var loadingStatus = document.getElementById("search-loading-status");
      var mainEl = document.getElementById("main-content");
      var chips = document.querySelectorAll(".hero__hint");
      var submitting = false;

      // "  aapl  " → "AAPL" before the browser sends anything.
      function normalizeSymbol(value) {
        return String(value || "").trim().toUpperCase();
      }

      // Mirrors the server's permissive format check.
      var SYMBOL_FORMAT = /^[A-Z0-9.\-^]{1,10}$/;

      function showFeedback(message) {
        if (!feedback) return;
        feedback.textContent = message;
        feedback.hidden = false;
      }

      function clearFeedback() {
        if (feedback) feedback.hidden = true;
      }

      function resetForm() {
        submitting = false;
        if (button) { button.disabled = false; button.classList.remove("is-loading"); }
        if (input) input.readOnly = false;
        if (form) form.removeAttribute("aria-busy");
        chips.forEach(function (chip) { chip.disabled = false; });
        if (loadingEl) loadingEl.hidden = true;
        if (resultsEl) resultsEl.hidden = false;
        if (mainEl) mainEl.removeAttribute("aria-busy");
      }

      function showLoading(symbol) {
        clearFeedback();
        if (resultsEl) resultsEl.hidden = true;
        if (loadingEl) loadingEl.hidden = false;
        if (loadingStatus) loadingStatus.textContent = "Fetching market data for " + symbol + "\u2026";
        if (mainEl) mainEl.setAttribute("aria-busy", "true");
      }

      form.addEventListener("submit", function (event) {
        var symbol = normalizeSymbol(input.value);
        input.value = symbol;

        // Duplicate submit (rapid clicks / Enter spam): drop it.
        if (submitting) {
          event.preventDefault();
          return;
        }

        if (!symbol) {
          event.preventDefault();
          showFeedback("Please enter a stock symbol.");
          return;
        }

        if (!SYMBOL_FORMAT.test(symbol)) {
          event.preventDefault();
          showFeedback("Please enter a valid stock symbol (letters, numbers, dots or hyphens only).");
          return;
        }

        // Valid: lock the form so a second request can't fire. The native
        // POST proceeds — the response page loads with a fresh, enabled form.
        submitting = true;
        if (button) { button.disabled = true; button.classList.add("is-loading"); }
        // readOnly (not disabled): disabled controls are omitted from the POST.
        if (input) input.readOnly = true;
        chips.forEach(function (chip) { chip.disabled = true; });
        form.setAttribute("aria-busy", "true");
        showLoading(symbol);

        // Safety net: if the navigation ever fails, re-enable the form anyway.
        setTimeout(resetForm, 30000);
      });

      // Popular chips fill the search box and submit the same form, so they
      // reuse validation, duplicate protection, and the loading state.
      chips.forEach(function (chip) {
        chip.addEventListener("click", function () {
          if (submitting || !input) return;

          var symbol = normalizeSymbol(chip.getAttribute("data-symbol") || chip.textContent);
          if (!symbol) return;

          input.value = symbol;
          clearFeedback();

          if (typeof form.requestSubmit === "function") {
            form.requestSubmit();
          } else {
            form.submit();
          }
        });
      });

      if (input) {
        input.addEventListener("input", clearFeedback);
      }

      // Restore the form when returning via the back/forward cache.
      window.addEventListener("pageshow", resetForm);
    })();
  </script>

  <!-- Watchlist: localStorage list, star toggle, and quick re-search -->
  <script type="module" src="/js/watchlist.js"></script>

  <!-- Quote refresh: fetch the JSON endpoint and update the card in place -->
  <script src="/js/quote-refresh.js"></script>

  <!-- Market news: fetched only when the user presses "Load news" -->
  <script src="/js/news.js"></script>

  <!-- Portfolio: localStorage positions and on-demand quote refreshes -->
  <script type="module" src="/js/portfolio.js"></script>

  <!-- ====== Historical Price Chart ====== -->

  <!-- 1) Server → browser bridge: historicalData was rendered into this page as JSON -->
  <script>
    window.FINSTOCK = window.FINSTOCK || {};
    window.FINSTOCK.historicalData = <%- historicalDataJson %>;
  </script>

  <!-- 2) Chart.js library (vendored locally — no CDN needed at runtime) -->
  <script src="/vendor/chart.umd.js"></script>

  <!-- 3) Draw the chart from window.FINSTOCK.historicalData (no API call from the browser) -->
  <script type="module" src="/js/chart.js"></script>

</body>
</html>